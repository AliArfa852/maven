#!/usr/bin/env python3
"""maven — one entrypoint for every maven-* CLI.

Discovers `scripts/maven-<name>` siblings and dispatches to them, the
same way `git` finds `git-foo`. Pure passthrough: any flags after the
subcommand name are forwarded as-is, so `maven mail list --pretty`
behaves exactly like `maven-mail list --pretty`.

Subcommands installed under the legacy `odysseus-<name>` name are still
found when no `maven-<name>` exists.

    maven                       # list every subcommand + short help
    maven <name>                # run maven-<name>
    maven <name> <args...>      # run maven-<name> <args...>
    maven help                  # alias for `maven` (the listing)
    maven help <name>           # show the subcommand's own --help
    maven --version             # print version

Designed to live in `scripts/`. Symlink it onto `$PATH` (`ln -s
$PWD/scripts/maven ~/.local/bin/maven`) to use it without typing
the full path.
"""
from __future__ import annotations

import os
import re
import subprocess
import sys
from pathlib import Path

VERSION = "0.1.0"

SCRIPTS_DIR = Path(__file__).resolve().parent

# Preferred prefix first; the legacy prefix is the fallback.
_PREFIXES = ("maven-", "odysseus-")


def _list_subcommands() -> list[Path]:
    """Find every executable `maven-*` (or legacy `odysseus-*`) next to this
    file, excluding the dispatchers themselves + any .bak / .pre-* leftovers.
    When both names exist for one subcommand, the `maven-` one wins."""
    found: dict[str, Path] = {}
    for p in sorted(SCRIPTS_DIR.iterdir()):
        if not p.is_file():
            continue
        prefix = next((pf for pf in _PREFIXES if p.name.startswith(pf)), None)
        if prefix is None:
            continue
        if any(p.name.endswith(suf) for suf in (".bak", ".pre-cli-refactor", ".pyc")):
            continue
        if not os.access(p, os.X_OK):
            continue
        name = p.name[len(prefix):]
        if name not in found or prefix == _PREFIXES[0]:
            found[name] = p
    return [found[k] for k in sorted(found)]


def _sub_name(path: Path) -> str:
    for pf in _PREFIXES:
        if path.name.startswith(pf):
            return path.name[len(pf):]
    return path.name


def _resolve_subcommand(name: str) -> Path | None:
    """`maven-<name>` if runnable, else the legacy `odysseus-<name>`."""
    if not name or "/" in name or "\\" in name or name.startswith("."):
        return None
    for pf in _PREFIXES:
        cand = SCRIPTS_DIR / f"{pf}{name}"
        if _is_runnable_subcommand(cand):
            return cand
    return None


def _short_help(path: Path) -> str:
    """Pull the first non-blank line of the docstring (after the shebang)
    as a 1-line description. Falls back to '(no description)'."""
    try:
        text = path.read_text(encoding="utf-8")
    except Exception:
        return "(unreadable)"
    m = re.search(r'"""(.*?)"""', text, re.DOTALL)
    if not m:
        return ""
    body = m.group(1).strip()
    if not body:
        return ""
    # First non-blank line, strip the leading "name — " noise.
    first = next((ln for ln in body.splitlines() if ln.strip()), "")
    first = re.sub(r"^(?:maven|odysseus)-\w+\s*—\s*", "", first).strip()
    return first


def _is_runnable_subcommand(path: Path) -> bool:
    return path.exists() and path.is_file() and os.access(path, os.X_OK)


def _print_listing() -> None:
    """`maven` with no args (or `maven help`) — print the table."""
    sys.stdout.write(f"maven {VERSION} — every feature, on the shell.\n\n")
    sys.stdout.write("Usage:  maven <subcommand> [args...]\n\n")
    sys.stdout.write("Available subcommands:\n")
    subs = _list_subcommands()
    width = max((len(_sub_name(p)) for p in subs), default=10)
    for p in subs:
        desc = _short_help(p)
        sys.stdout.write(f"  {_sub_name(p):<{width + 2}}{desc}\n")
    sys.stdout.write(
        "\nRun `maven help <subcommand>` for that tool's own --help.\n"
    )


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)

    if not argv or argv[0] in ("-h", "--help", "help") and len(argv) == 1:
        _print_listing()
        return 0

    if argv[0] in ("-v", "--version"):
        sys.stdout.write(f"maven {VERSION}\n")
        return 0

    if argv[0] == "help":
        # `maven help foo` → `maven-foo --help`
        if len(argv) < 2:
            _print_listing()
            return 0
        sub = _resolve_subcommand(argv[1])
        if sub is None:
            sys.stderr.write(f"maven: unknown subcommand {argv[1]!r}\n")
            return 1
        return subprocess.call([str(sub), "--help"])

    # `maven foo ...` → exec `maven-foo ...` under the project venv.
    name = argv[0]
    sub = _resolve_subcommand(name)
    if sub is None:
        sys.stderr.write(
            f"maven: unknown subcommand {name!r}. "
            f"Try `maven help` to see available ones.\n"
        )
        return 1
    # Run the subcommand with the project's venv Python so dependencies
    # (bcrypt, sqlalchemy, fastapi, ...) resolve. Fall back to whatever
    # `python` is on PATH if no venv is found — useful in container
    # installs that wire the deps system-wide.
    repo_root = SCRIPTS_DIR.parent
    venv_python = repo_root / "venv" / "bin" / "python"
    py = str(venv_python) if venv_python.exists() else sys.executable
    os.execv(py, [py, str(sub)] + argv[1:])
    return 0  # unreachable


if __name__ == "__main__":
    sys.exit(main())
