# Maven: local Docker settings, ready to run as-is.
#
#   cp docker/local.env.example .env        (Windows: copy docker\local.env.example .env)
#   docker compose up -d --build
#   open http://localhost:7000 and log in with the admin below
#
# FOR LOCAL TESTING ONLY. The admin password below is a placeholder that
# everyone can read in this file. Change it (or leave it empty so a random one
# is printed once in `docker logs maven`) before anyone else can reach the app.
#
# Every MAVEN_AI_* name also accepts its old ODYSSEUS_* name; the new one wins.

# --- Admin account (created on first start only) ---------------------------
MAVEN_AI_ADMIN_USER=admin
MAVEN_AI_ADMIN_PASSWORD=maven-local-test

# --- Where the app listens ------------------------------------------------
# 127.0.0.1 keeps it on this computer. Use 0.0.0.0 only behind HTTPS + auth.
APP_BIND=127.0.0.1
APP_PORT=7000
# Data and logs live in these host folders and survive container rebuilds.
APP_DATA_DIR=./data
APP_LOGS_DIR=./logs

# --- Security (keep these for any shared machine) ---------------------------
AUTH_ENABLED=true
LOCALHOST_BYPASS=false
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:7000,http://127.0.0.1:7000
# Empty = Secure cookies only when the request arrives over HTTPS.
SECURE_COOKIES=

# --- Models -----------------------------------------------------------------
# Ollama running on the host (Windows, macOS or Linux) is reached from the
# container through host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_HOST=host.docker.internal
LLM_HOSTS=
# Cloud providers stay off for local-only use; fill in only if you want them.
OPENAI_API_KEY=
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=
RESEARCH_LLM_ENDPOINT=

# --- Embeddings (built-in local model by default) -----------------------------
EMBEDDING_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
FASTEMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
FASTEMBED_CACHE_PATH=

# --- Database ---------------------------------------------------------------
# SQLite in ./data for local testing. Corporate installs will use PostgreSQL
# (decision D-2-1), e.g. postgresql://maven:<password>@postgres:5432/maven
DATABASE_URL=sqlite:///./data/app.db

# --- Image --------------------------------------------------------------------
# Empty uses ghcr.io/aliarfa852/maven:latest; if that can't be pulled, Docker
# builds this checkout instead (that is what `--build` above forces anyway).
MAVEN_AI_IMAGE=

# --- File ownership on the host (Linux; harmless on Windows/macOS) -------------
PUID=1000
PGID=1000

# --- Side services (only reachable from this computer) ------------------------
CHROMADB_BIND=127.0.0.1
NTFY_BIND=127.0.0.1
NTFY_BASE_URL=http://localhost:8091
# Empty = generated on first start.
SEARXNG_SECRET=

# --- Optional integrations (leave empty for local testing) ----------------------
DATA_BRAVE_API_KEY=
GOOGLE_API_KEY=
GOOGLE_PSE_CX=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
OAUTH_REDIRECT_BASE_URL=
TAVILY_API_KEY=
SERPER_API_KEY=
COMPANION_BASE_URL=

# --- Background work and limits (defaults are fine) -----------------------------
CLEANUP_INTERVAL_HOURS=24
MAVEN_AI_INPROCESS_POLLERS=1
MAVEN_AI_INPROCESS_TASKS=1
MAVEN_AI_SCRIPT_HOST=localhost
MAVEN_AI_CHAT_UPLOAD_MAX_BYTES=10485760
MAVEN_AI_GALLERY_UPLOAD_MAX_BYTES=104857600
MAVEN_AI_GALLERY_TRANSFORM_UPLOAD_MAX_BYTES=26214400
MAVEN_AI_MEMORY_IMPORT_MAX_BYTES=10485760
MAVEN_AI_PERSONAL_UPLOAD_MAX_BYTES=26214400
MAVEN_AI_EMAIL_COMPOSE_UPLOAD_MAX_BYTES=26214400
MAVEN_AI_STT_MAX_AUDIO_BYTES=26214400
MAVEN_AI_ICS_MAX_BYTES=10485760
# Empty = no TTS cache size limit.
MAVEN_AI_TTS_CACHE_MAX_BYTES=
